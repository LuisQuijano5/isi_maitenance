{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/maintenance/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://maintenance-backend:8080"
          }
        }
      }
    }
  }
}